<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>Instalador do Leitor da Balança SiagroB1</AssemblyTitle>
    <Product>SiagroB1</Product>
    <Company>IDX Sistemas</Company>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SiagroB1.Installer.Core\SiagroB1.Installer.Core.csproj" />
  </ItemGroup>

  <!-- O build-client-installer.ps1 passa -p:ClientZip=<caminho> para embutir o SiagroB1.Client publicado. -->
  <ItemGroup Condition="'$(ClientZip)' != ''">
    <EmbeddedResource Include="$(ClientZip)" LogicalName="client.zip" />
  </ItemGroup>

</Project>
