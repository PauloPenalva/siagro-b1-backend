<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- The real report templates, so ReportTemplateHeaderTests can load them. -->
    <None Include="..\SiagroB1.Reports\Reports\Templates\*.frx"
          Exclude="..\SiagroB1.Reports\Reports\Templates\Teste.frx"
          Link="ReportTemplates\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\SiagroB1.Reports\wwwroot\images\*"
          Link="ReportsContentRoot\wwwroot\images\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SiagroB1.Application\SiagroB1.Application.csproj" />
    <ProjectReference Include="..\SiagroB1.Reports\SiagroB1.Reports.csproj" />
    <!-- Para inspecionar o EDM real montado por ODataConfigurations. -->
    <ProjectReference Include="..\SiagroB1.Web\SiagroB1.Web.csproj" />
  </ItemGroup>

</Project>