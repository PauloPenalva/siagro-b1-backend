  <Styles>
    <Style Name="EvenRows" Fill.Color="Gainsboro" Font="Arial, 10pt"/>
  </Styles>
  <Dictionary>
    <BusinessObjectDataSource Name="InvoiceItems" ReferenceName="InvoiceItems" DataType="System.Int32" Enabled="true">
      <Column Name="Group" DataType="System.String"/>
      <Column Name="IssueDate" DataType="System.String"/>
      <Column Name="InternalNumber" DataType="System.String"/>
