    <Total Name="TotalGrpIbsCbs" Expression="[InvoiceItems.IbsCbs]" Evaluator="Data1" PrintOn="GroupFooter1"/>
    <Total Name="TotalSumTotal" Expression="[InvoiceItems.Total]" Evaluator="Data1" PrintOn="ReportSummary1"/>
    <Total Name="TotalSumGrandTotal" Expression="[InvoiceItems.GrandTotal]" Evaluator="Data1" PrintOn="ReportSummary1"/>
