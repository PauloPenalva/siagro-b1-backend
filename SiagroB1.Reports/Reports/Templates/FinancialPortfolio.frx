<Report ScriptLanguage="CSharp" ReportInfo.Created="10/20/2026 10:00:00" ReportInfo.Modified="10/20/2026 10:00:00" ReportInfo.CreatorVersion="2026.1.0.0">
  <Dictionary>
    <BusinessObjectDataSource Name="PortfolioRows" ReferenceName="PortfolioRows" DataType="System.Int32" Enabled="true">
      <Column Name="GroupKey" DataType="System.String"/>
      <Column Name="Partner" DataType="System.String"/>
      <Column Name="Document" DataType="System.String"/>
      <Column Name="Origin" DataType="System.String"/>
      <Column Name="NfeNumber" DataType="System.String"/>
      <Column Name="NfeSeries" DataType="System.String"/>
      <Column Name="DocumentDate" DataType="System.String"/>
      <Column Name="DueDate" DataType="System.String"/>
      <Column Name="Currency" DataType="System.String"/>
      <Column Name="Amount" DataType="System.Decimal"/>
      <Column Name="Settled" DataType="System.Decimal"/>
      <Column Name="Open" DataType="System.Decimal"/>
      <Column Name="DaysOverdue" DataType="System.Int32"/>
    </BusinessObjectDataSource>
    <Parameter Name="pCompanyName" DataType="System.String" AsString=""/>
    <Parameter Name="pStandalone" DataType="System.Boolean" AsString="true"/>
    <Parameter Name="pTitle" DataType="System.String" AsString=""/>
    <Parameter Name="pPeriod" DataType="System.String" AsString=""/>
    <Parameter Name="pMode" DataType="System.String" AsString=""/>
    <Parameter Name="pTotals" DataType="System.String" AsString=""/>
    <Parameter Name="pRowCount" DataType="System.Int32" AsString="0"/>
    <Total Name="SubAmount" Expression="[PortfolioRows.Amount]" Evaluator="Data1" PrintOn="GroupFooter1"/>
    <Total Name="SubSettled" Expression="[PortfolioRows.Settled]" Evaluator="Data1" PrintOn="GroupFooter1"/>
    <Total Name="SubOpen" Expression="[PortfolioRows.Open]" Evaluator="Data1" PrintOn="GroupFooter1"/>
  </Dictionary>
