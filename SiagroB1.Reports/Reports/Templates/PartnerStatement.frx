        <TextObject Name="txtRowDocument" Left="314" Width="110" Height="17" Text="[StatementRows.Document]" Trimming="EllipsisCharacter" VertAlign="Center" WordWrap="false" Font="Consolas, 7pt"/>
        <TextObject Name="txtRowDebit" Left="426" Width="100" Height="17" Text="[StatementRows.Debit]" HideZeros="true" Format="Number" Format.UseLocale="true" Format.DecimalDigits="2" HorzAlign="Right" VertAlign="Center" WordWrap="false" Font="Consolas, 7pt"/>
        <TextObject Name="txtRowCredit" Left="528" Width="100" Height="17" Text="[StatementRows.Credit]" HideZeros="true" Format="Number" Format.UseLocale="true" Format.DecimalDigits="2" HorzAlign="Right" VertAlign="Center" WordWrap="false" Font="Consolas, 7pt"/>
        <TextObject Name="txtRowBalance" Left="630" Width="100" Height="17" Text="[StatementRows.Balance]" Format="Number" Format.UseLocale="true" Format.DecimalDigits="2" HorzAlign="Right" VertAlign="Center" WordWrap="false" Font="Consolas, 7pt"/>
      </DataBand>
      <GroupFooterBand Name="GroupFooter1" Top="219.8" Width="733.32" Height="21" Border.Lines="Top" Border.Style="Dot">
        <TextObject Name="lblClosing" Left="0" Top="2" Width="424" Height="17" Text="Saldo final ([StatementRows.Currency])" VertAlign="Center" WordWrap="false" Font="Consolas, 8pt, style=Bold"/>
        <TextObject Name="txtSumDebit" Left="426" Top="2" Width="100" Height="17" Text="[CurrencyDebit]" Format="Number" Format.UseLocale="true" Format.DecimalDigits="2" HorzAlign="Right" VertAlign="Center" WordWrap="false" Font="Consolas, 7pt, style=Bold"/>
        <TextObject Name="txtSumCredit" Left="528" Top="2" Width="100" Height="17" Text="[CurrencyCredit]" Format="Number" Format.UseLocale="true" Format.DecimalDigits="2" HorzAlign="Right" VertAlign="Center" WordWrap="false" Font="Consolas, 7pt, style=Bold"/>
        <TextObject Name="txtClosing" Left="630" Top="2" Width="100" Height="17" Text="[StatementRows.ClosingBalance]" Format="Number" Format.UseLocale="true" Format.DecimalDigits="2" HorzAlign="Right" VertAlign="Center" WordWrap="false" Font="Consolas, 8pt, style=Bold"/>
      </GroupFooterBand>
    </GroupHeaderBand>
    <ReportSummaryBand Name="ReportSummary1" Top="244" Width="733.32" Height="40" CanGrow="true" Border.Lines="Top">
      <TextObject Name="txtTotals" Left="0" Top="4" Width="733.32" Height="17" CanGrow="true" Text="[pTotals]" HorzAlign="Right" Font="Consolas, 7pt, style=Bold"/>
      <TextObject Name="txtEmpty" Left="0" Top="22" Width="733.32" Height="17" Text="[IIf([pRowCount] == 0, &quot;Nenhum movimento no período.&quot;, &quot;&quot;)]" HorzAlign="Center" VertAlign="Center" WordWrap="false" Font="Consolas, 8pt, style=Italic"/>
    </ReportSummaryBand>
    <PageFooterBand Name="PageFooter1" Top="287.2" Width="733.32" Height="22">
