      <TextObject Name="hdrProduct" Left="392" Width="260" Height="17" Text="Produto" VertAlign="Bottom" WordWrap="false" Font="Consolas, 7pt, style=Bold, Italic"/>
      <TextObject Name="hdrQuantity" Left="652" Width="85" Height="17" Text="Qtd devolvida" HorzAlign="Right" VertAlign="Bottom" WordWrap="false" Font="Consolas, 7pt, style=Bold, Italic"/>
      <TextObject Name="hdrUom" Left="737" Width="35" Height="17" Text="UM" VertAlign="Bottom" WordWrap="false" Font="Consolas, 7pt, style=Bold, Italic"/>
      <TextObject Name="hdrValue" Left="772" Width="95" Height="17" Text="Valor" HorzAlign="Right" VertAlign="Bottom" WordWrap="false" Font="Consolas, 7pt, style=Bold, Italic"/>
      <TextObject Name="hdrStatus" Left="867" Width="75" Height="17" Text="Situação" VertAlign="Bottom" WordWrap="false" Font="Consolas, 7pt, style=Bold, Italic"/>
    </ColumnHeaderBand>
    <GroupHeaderBand Name="GroupHeader1" SortOrder="None" Top="136.7" Width="1084" Height="20" Condition="[SalesReturns.Customer]">
      <TextObject Name="txtGroup" Left="0" Top="2" Width="700" Height="17" Text="[SalesReturns.Customer]" VertAlign="Center" WordWrap="false" Font="Arial, 8pt, style=Bold"/>
      <DataBand Name="Data1" Top="159.75" Width="1084" Height="17" CanGrow="true" EvenStyle="EvenRows" DataSource="SalesReturns">
        <TextObject Name="txtDate" Left="0" Width="62" Height="17" Text="[SalesReturns.Date]" Trimming="EllipsisCharacter" VertAlign="Center" WordWrap="false" Font="Consolas, 7pt"/>
        <TextObject Name="txtSource" Left="62" Width="55" Height="17" Text="[SalesReturns.Source]" Trimming="EllipsisCharacter" VertAlign="Center" WordWrap="false" Font="Consolas, 7pt"/>
        <TextObject Name="txtInternalNumber" Left="117" Width="60" Height="17" Text="[SalesReturns.InternalNumber]" Trimming="EllipsisCharacter" VertAlign="Center" WordWrap="false" Font="Consolas, 7pt"/>
        <TextObject Name="txtDocumentNumber" Left="177" Width="82" Height="17" Text="[SalesReturns.DocumentNumber]" Trimming="EllipsisCharacter" VertAlign="Center" WordWrap="false" Font="Consolas, 7pt"/>
        <TextObject Name="txtOrigin" Left="259" Width="133" Height="17" Text="[SalesReturns.Origin]" Trimming="EllipsisCharacter" VertAlign="Center" WordWrap="false" Font="Consolas, 7pt"/>
        <TextObject Name="txtProduct" Left="392" Width="260" Height="17" Text="[SalesReturns.Product]" Trimming="EllipsisCharacter" VertAlign="Center" WordWrap="false" Font="Consolas, 7pt"/>
        <TextObject Name="txtQuantity" Left="652" Width="85" Height="17" Text="[SalesReturns.Quantity]" Format="Number" Format.UseLocale="true" Format.DecimalDigits="3" HorzAlign="Right" Trimming="EllipsisCharacter" VertAlign="Center" WordWrap="false" Font="Consolas, 7pt"/>
        <TextObject Name="txtUom" Left="737" Width="35" Height="17" Text="[SalesReturns.UnitOfMeasure]" Trimming="EllipsisCharacter" VertAlign="Center" WordWrap="false" Font="Consolas, 7pt"/>
        <TextObject Name="txtValue" Left="772" Width="95" Height="17" Text="[SalesReturns.Value]" Format="Number" Format.UseLocale="true" Format.DecimalDigits="2" HorzAlign="Right" Trimming="EllipsisCharacter" VertAlign="Center" WordWrap="false" Font="Consolas, 7pt"/>
        <TextObject Name="txtStatus" Left="867" Width="75" Height="17" Text="[SalesReturns.Status]" Trimming="EllipsisCharacter" VertAlign="Center" WordWrap="false" Font="Consolas, 7pt"/>
      </DataBand>
      <GroupFooterBand Name="GroupFooter1" Top="180" Width="1084" Height="20">
        <TextObject Name="txtGrpLabel" Left="0" Top="2" Width="392" Height="17" Text="Subtotal do cliente:" HorzAlign="Right" VertAlign="Center" WordWrap="false" Font="Consolas, 7pt, style=Bold, Italic"/>
        <TextObject Name="txtGrpCount" Left="392" Top="2" Width="120" Height="17" Text="[TotalGrpCount] item(ns)" HorzAlign="Right" VertAlign="Center" WordWrap="false" Font="Consolas, 7pt, style=Bold, Italic"/>
        <TextObject Name="txtGrpValue" Left="772" Top="2" Width="95" Height="17" Text="[TotalGrpValue]" Format="Number" Format.UseLocale="true" Format.DecimalDigits="2" HorzAlign="Right" VertAlign="Center" WordWrap="false" Font="Consolas, 7pt, style=Bold, Italic"/>
      </GroupFooterBand>
    </GroupHeaderBand>
    <ReportSummaryBand Name="ReportSummary1" Top="203" Width="1084" Height="48">
      <TextObject Name="txtSumLabel" Left="0" Top="4" Width="130" Height="17" Text="TOTAL GERAL:" VertAlign="Center" WordWrap="false" Font="Consolas, 8pt, style=Bold"/>
      <TextObject Name="txtSumCount" Left="130" Top="4" Width="90" Height="17" Text="[TotalCountAll] item(ns)" HorzAlign="Right" VertAlign="Center" WordWrap="false" Font="Consolas, 7pt, style=Bold"/>
      <TextObject Name="txtSumValue" Left="772" Top="4" Width="95" Height="17" Text="[TotalSumValue]" Format="Number" Format.UseLocale="true" Format.DecimalDigits="2" HorzAlign="Right" VertAlign="Center" WordWrap="false" Font="Consolas, 7pt, style=Bold"/>
      <TextObject Name="txtEmpty" Left="0" Top="26" Width="1084" Height="17" Text="[IIf([TotalCountAll] == 0, &quot;Nenhum registro encontrado.&quot;, &quot;&quot;)]" HorzAlign="Center" VertAlign="Center" WordWrap="false" Font="Consolas, 8pt, style=Italic"/>
    </ReportSummaryBand>
    <PageFooterBand Name="PageFooter1" Top="254" Width="1084" Height="26">
      <TextObject Name="txtPage" Left="937" Width="147" Height="17" Text="Página [Page#] de [TotalPages#]" HorzAlign="Right" VertAlign="Center" WordWrap="false" Font="Consolas, 7pt"/>
    </PageFooterBand>
  </ReportPage>
</Report>
