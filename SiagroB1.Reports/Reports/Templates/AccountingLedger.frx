<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" ReportInfo.Created="10/22/2026 10:00:00" ReportInfo.Modified="10/22/2026 10:00:00" ReportInfo.CreatorVersion="2026.1.0.0">
  <Dictionary>
    <BusinessObjectDataSource Name="LedgerRows" ReferenceName="LedgerRows" DataType="System.Int32" Enabled="true">
      <Column Name="AccountCode" DataType="System.String"/>
      <Column Name="AccountName" DataType="System.String"/>
      <Column Name="Date" DataType="System.String"/>
      <Column Name="Document" DataType="System.String"/>
      <Column Name="BranchCode" DataType="System.String"/>
      <Column Name="History" DataType="System.String"/>
      <Column Name="Counterpart" DataType="System.String"/>
      <Column Name="CostCenterCode" DataType="System.String"/>
      <Column Name="Debit" DataType="System.Decimal"/>
      <Column Name="Credit" DataType="System.Decimal"/>
      <Column Name="Balance" DataType="System.Decimal"/>
      <Column Name="BalanceSide" DataType="System.String"/>
    </BusinessObjectDataSource>
    <Parameter Name="pCompanyName" DataType="System.String" AsString=""/>
    <Parameter Name="pStandalone" DataType="System.Boolean" AsString="true"/>
    <Parameter Name="pPeriod" DataType="System.String" AsString=""/>
    <Parameter Name="pFilters" DataType="System.String" AsString=""/>
    <Parameter Name="pTotalDebit" DataType="System.Decimal" AsString="0"/>
    <Parameter Name="pTotalCredit" DataType="System.Decimal" AsString="0"/>
  </Dictionary>
  <ReportPage Name="Page1" PaperWidth="210" PaperHeight="297" LeftMargin="8" TopMargin="8" RightMargin="8" BottomMargin="8" RawPaperSize="9" Watermark.Font="Arial, 60pt">
    <PageHeaderBand Name="PageHeader1" Width="733.4" Height="115">
      <PictureObject Name="picLogo" Left="0" Top="2" Width="94.5" Height="37.8" SizeMode="Zoom"/>
      <TextObject Name="txtCompany" Left="100" Top="2" Width="480" Height="37.8" Text="[pCompanyName]" VertAlign="Center" Font="Arial, 11pt, style=Bold"/>
      <TextObject Name="txtDate" Left="586" Top="2" Width="147.4" Height="18.9" Text="[Date]" Format="Date" Format.Format="d" HorzAlign="Right" VertAlign="Center" Font="Tahoma, 6pt"/>
      <TextObject Name="txtTitle" Top="45" Width="733.4" Height="26" Text="Razão Contábil" HorzAlign="Center" VertAlign="Center" Font="Arial, 14pt, style=Bold, Italic"/>
      <TextObject Name="txtPeriod" Top="73" Width="733.4" Height="17" Text="[pPeriod]" HorzAlign="Center" VertAlign="Center" Font="Consolas, 8pt, style=Italic"/>
      <TextObject Name="txtFilters" Top="90" Width="733.4" Height="17" Text="[pFilters]" HorzAlign="Center" VertAlign="Center" Font="Consolas, 8pt"/>
