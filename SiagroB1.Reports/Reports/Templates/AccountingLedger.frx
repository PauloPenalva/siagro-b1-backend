    <ColumnHeaderBand Name="ColumnHeader1" Width="733.4" Height="19" Border.Lines="Bottom">
      <TextObject Name="hdrDate" Left="0" Top="0" Width="55" Height="17" WordWrap="false" Trimming="EllipsisCharacter" Text="Data" HorzAlign="Left" VertAlign="Center" Font="Consolas, 7pt, style=Bold, Italic"/>
