      <TextObject Name="hdrHistory" Left="137" Top="0" Width="215" Height="17" WordWrap="false" Trimming="EllipsisCharacter" Text="Histórico" HorzAlign="Left" VertAlign="Center" Font="Consolas, 7pt, style=Bold, Italic"/>
      <TextObject Name="hdrCounterpart" Left="353" Top="0" Width="70" Height="17" WordWrap="false" Trimming="EllipsisCharacter" Text="Contrapartida" HorzAlign="Left" VertAlign="Center" Font="Consolas, 7pt, style=Bold, Italic"/>
      <TextObject Name="hdrCc" Left="424" Top="0" Width="45" Height="17" WordWrap="false" Trimming="EllipsisCharacter" Text="C.Custo" HorzAlign="Left" VertAlign="Center" Font="Consolas, 7pt, style=Bold, Italic"/>
      <TextObject Name="hdrDebit" Left="470" Top="0" Width="85" Height="17" WordWrap="false" Trimming="EllipsisCharacter" Text="Débito" HorzAlign="Right" VertAlign="Center" Font="Consolas, 7pt, style=Bold, Italic"/>
      <TextObject Name="hdrCredit" Left="556" Top="0" Width="85" Height="17" WordWrap="false" Trimming="EllipsisCharacter" Text="Crédito" HorzAlign="Right" VertAlign="Center" Font="Consolas, 7pt, style=Bold, Italic"/>
      <TextObject Name="hdrBalance" Left="642" Top="0" Width="91.4" Height="17" WordWrap="false" Trimming="EllipsisCharacter" Text="Saldo" HorzAlign="Right" VertAlign="Center" Font="Consolas, 7pt, style=Bold, Italic"/>
    </ColumnHeaderBand>
    <GroupHeaderBand Name="GroupAccount" Width="733.4" Height="21" Condition="[LedgerRows.AccountCode]" SortOrder="None" KeepWithData="true">
      <TextObject Name="txtAccount" Left="0" Top="2" Width="733.4" Height="17" WordWrap="false" Trimming="EllipsisCharacter" Text="Conta: [LedgerRows.AccountCode] - [LedgerRows.AccountName]" HorzAlign="Left" VertAlign="Center" Font="Consolas, 7pt, style=Bold"/>
      <DataBand Name="Data1" Width="733.4" Height="17" CanGrow="true" DataSource="LedgerRows">
        <TextObject Name="txtRowDate" Left="0" Top="0" Width="55" Height="17" WordWrap="false" Trimming="EllipsisCharacter" Text="[LedgerRows.Date]" HorzAlign="Left" VertAlign="Center" Font="Consolas, 7pt"/>
