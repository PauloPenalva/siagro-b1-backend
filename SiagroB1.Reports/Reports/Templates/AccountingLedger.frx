        <TextObject Name="txtRowHistory" Left="137" Top="0" Width="215" Height="17" CanGrow="true" Text="[LedgerRows.History]" HorzAlign="Left" VertAlign="Center" Font="Consolas, 7pt"/>
        <TextObject Name="txtRowCounterpart" Left="353" Top="0" Width="70" Height="17" WordWrap="false" Trimming="EllipsisCharacter" Text="[LedgerRows.Counterpart]" HorzAlign="Left" VertAlign="Center" Font="Consolas, 7pt"/>
        <TextObject Name="txtRowCc" Left="424" Top="0" Width="45" Height="17" WordWrap="false" Trimming="EllipsisCharacter" Text="[LedgerRows.CostCenterCode]" HorzAlign="Left" VertAlign="Center" Font="Consolas, 7pt"/>
        <TextObject Name="txtRowDebit" Left="470" Width="85" Height="17" Text="[IIf([LedgerRows.Debit] == 0, &quot;&quot;, Format(&quot;{0:N2}&quot;, [LedgerRows.Debit]))]" HorzAlign="Right" VertAlign="Center" WordWrap="false" Font="Consolas, 7pt"/>
        <TextObject Name="txtRowCredit" Left="556" Width="85" Height="17" Text="[IIf([LedgerRows.Credit] == 0, &quot;&quot;, Format(&quot;{0:N2}&quot;, [LedgerRows.Credit]))]" HorzAlign="Right" VertAlign="Center" WordWrap="false" Font="Consolas, 7pt"/>
        <TextObject Name="txtRowBalance" Left="642" Width="91.4" Height="17" Text="[Format(&quot;{0:N2}&quot;, [LedgerRows.Balance])] [LedgerRows.BalanceSide]" HorzAlign="Right" VertAlign="Center" WordWrap="false" Font="Consolas, 7pt"/>
