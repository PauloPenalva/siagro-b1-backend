    <Parameter Name="pRowCount" DataType="System.Int32" AsString="0"/>
    <Total Name="TotQ1" Expression="[Rows.Q1]" Evaluator="Data1" PrintOn="GroupFooter1"/>
    <Total Name="TotQ2" Expression="[Rows.Q2]" Evaluator="Data1" PrintOn="GroupFooter1"/>
