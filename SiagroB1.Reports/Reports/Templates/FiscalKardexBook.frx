      <TextObject Name="hdrSeries" Left="40.0" Top="48" Width="35" Height="28" Border.Lines="All" Text="Série" HorzAlign="Center" VertAlign="Center" WordWrap="true" Font="Arial, 7pt, style=Bold"/>
      <TextObject Name="hdrNumber" Left="75.0" Top="48" Width="75" Height="28" Border.Lines="All" Text="Número" HorzAlign="Center" VertAlign="Center" WordWrap="true" Font="Arial, 7pt, style=Bold"/>
