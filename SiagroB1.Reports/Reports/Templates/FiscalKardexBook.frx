      <TextObject Name="hdrDocument" Left="0.0" Top="34" Width="210.0" Height="14" Border.Lines="All" Text="DOCUMENTO" HorzAlign="Center" VertAlign="Center" Font="Arial, 7pt, style=Bold"/>
