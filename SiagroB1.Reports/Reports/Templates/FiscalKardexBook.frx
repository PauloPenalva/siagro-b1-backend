        <TextObject Name="txtIpiText" Left="610.0" Width="55" Height="14" Border.Lines="Left, Right" Text="[Rows.IpiText]" HorzAlign="Right" VertAlign="Center" WordWrap="false" Font="Courier New, 7pt"/>
