      <Column Name="TotalInValueText" DataType="System.String"/>
      <Column Name="TotalOutQuantityText" DataType="System.String"/>
      <Column Name="TotalOutValueText" DataType="System.String"/>
      <Column Name="ClosingBalanceText" DataType="System.String"/>
      <Column Name="IsOpening" DataType="System.Boolean"/>
    </BusinessObjectDataSource>
    <Parameter Name="pLegalName" DataType="System.String" AsString=""/>
    <Parameter Name="pBranchName" DataType="System.String" AsString=""/>
    <Parameter Name="pTaxId" DataType="System.String" AsString=""/>
    <Parameter Name="pStateRegistration" DataType="System.String" AsString=""/>
    <Parameter Name="pAddress" DataType="System.String" AsString=""/>
    <Parameter Name="pCityDate" DataType="System.String" AsString=""/>
    <Parameter Name="pPeriod" DataType="System.String" AsString=""/>
    <Parameter Name="pBookNumber" DataType="System.Int32" AsString="1"/>
    <Parameter Name="pFirstSheet" DataType="System.Int32" AsString="1"/>
  </Dictionary>

  <!-- Termo de abertura: folha = pFirstSheet -->
  <ReportPage Name="OpeningPage" Landscape="true" PaperWidth="297" PaperHeight="210" LeftMargin="10" TopMargin="10" RightMargin="10" BottomMargin="10" RawPaperSize="9" Watermark.Font="Arial, 60pt">
    <ReportTitleBand Name="OpeningTitle" Width="1047.6" Height="640">
      <PictureObject Name="picLogo" Left="0" Top="0" Width="94.5" Height="37.8" SizeMode="Zoom"/>
      <TextObject Name="txtSheetOpening" Left="847.6" Width="200" Height="18.9" Text="Folha nº [[pFirstSheet] + [Page] - 1]" HorzAlign="Right" Font="Arial, 9pt"/>
      <TextObject Name="txtOpeningTitleText" Top="70" Width="1047.6" Height="30" Text="TERMO DE ABERTURA" HorzAlign="Center" Font="Arial, 16pt, style=Bold"/>
      <TextObject Name="txtOpeningSubtitle" Top="105" Width="1047.6" Height="22" Text="REGISTRO DE CONTROLE DA PRODUÇÃO E DO ESTOQUE - MODELO 3 - LIVRO Nº [pBookNumber]" HorzAlign="Center" Font="Arial, 11pt, style=Bold"/>
      <TextObject Name="txtOpeningTerm" CanGrow="true" Left="120" Top="160" Width="807.6" Height="140" Text="Contém este livro [TotalPages] folhas numeradas tipograficamente, do nº [pFirstSheet] ao nº [[pFirstSheet] + [TotalPages] - 1], e servirá para o lançamento do Registro de Controle da Produção e do Estoque do período de [pPeriod] de [pLegalName], estabelecida em [pAddress], inscrita no CNPJ sob o nº [pTaxId] e com Inscrição Estadual nº [pStateRegistration]." HorzAlign="Justify" WordWrap="true" LineHeight="20" Font="Arial, 11pt"/>
      <TextObject Name="txtOpeningCityDate" Left="120" Top="330" Width="807.6" Height="20" Text="[pCityDate]" HorzAlign="Right" Font="Arial, 11pt"/>
      <TextObject Name="txtOpeningSign1" Left="120" Top="460" Width="300" Height="36" Border.Lines="Top" Text="Responsável" HorzAlign="Center" Font="Arial, 10pt"/>
      <TextObject Name="txtOpeningSign2" Left="627.6" Top="460" Width="300" Height="36" Border.Lines="Top" Text="Contabilista" HorzAlign="Center" Font="Arial, 10pt"/>
    </ReportTitleBand>
  </ReportPage>

  <!-- Fichas: uma por produto x mês, cada uma em folha nova (base: MATR470 do Protheus).
       SortOrder="None": as linhas já vêm na ordem certa (saldo inicial primeiro). -->
  <ReportPage Name="SheetsPage" Landscape="true" PaperWidth="297" PaperHeight="210" LeftMargin="10" TopMargin="10" RightMargin="10" BottomMargin="10" RawPaperSize="9" Watermark.Font="Arial, 60pt">
    <PageHeaderBand Name="PageHeader1" Width="1047.6" Height="62">
      <TextObject Name="txtTitle" Width="787.6" Height="18" Text="REGISTRO DE CONTROLE DA PRODUÇÃO E DO ESTOQUE - MODELO 3 - LIVRO Nº [pBookNumber]" Font="Arial, 10pt, style=Bold"/>
      <TextObject Name="txtFirm" Top="20" Width="787.6" Height="14" Text="FIRMA: [pLegalName]     [pBranchName]" Font="Arial, 8pt"/>
      <TextObject Name="txtIds" Top="34" Width="787.6" Height="14" Text="INSCR. ESTADUAL: [pStateRegistration]     CNPJ: [pTaxId]" Font="Arial, 8pt"/>
      <TextObject Name="txtSheet" Top="48" Width="200" Height="14" Text="Folha nº [[pFirstSheet] + [Page] - 1]" Font="Arial, 8pt, style=Bold"/>
      <TextObject Name="txtLegend" Left="792.6" Width="255" Height="58" Border.Lines="All" Text="(*) CÓDIGO DE ENTRADAS E SAÍDAS&#13;&#10;1 - NO PRÓPRIO ESTABELECIMENTO&#13;&#10;2 - EM OUTRO ESTABELECIMENTO&#13;&#10;3 - DIVERSAS" Padding="4, 2, 2, 2" Font="Arial, 7pt"/>
    </PageHeaderBand>
    <GroupHeaderBand Name="SheetHeader" Top="66" Width="1047.6" Height="78" Condition="[Rows.SheetKey]" SortOrder="None" StartNewPage="true" RepeatOnEveryPage="true">
