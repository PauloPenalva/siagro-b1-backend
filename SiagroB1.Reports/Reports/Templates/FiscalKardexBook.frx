<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" DoublePass="true" ReportInfo.Created="10/22/2026 10:00:00" ReportInfo.Modified="10/22/2026 10:00:00" ReportInfo.CreatorVersion="2026.1.0.0">
  <Dictionary>
    <BusinessObjectDataSource Name="Rows" ReferenceName="Rows" DataType="System.Int32" Enabled="true">
      <Column Name="SheetKey" DataType="System.String"/>
      <Column Name="Period" DataType="System.String"/>
      <Column Name="Product" DataType="System.String"/>
      <Column Name="UnitOfMeasureCode" DataType="System.String"/>
      <Column Name="Ncm" DataType="System.String"/>
      <Column Name="Species" DataType="System.String"/>
      <Column Name="Series" DataType="System.String"/>
      <Column Name="Number" DataType="System.String"/>
      <Column Name="DateText" DataType="System.String"/>
      <Column Name="Day" DataType="System.String"/>
      <Column Name="LedgerAccount" DataType="System.String"/>
      <Column Name="Cfop" DataType="System.String"/>
      <Column Name="Direction" DataType="System.String"/>
      <Column Name="Code" DataType="System.String"/>
      <Column Name="QuantityText" DataType="System.String"/>
      <Column Name="ValueText" DataType="System.String"/>
      <Column Name="IpiText" DataType="System.String"/>
      <Column Name="BalanceText" DataType="System.String"/>
