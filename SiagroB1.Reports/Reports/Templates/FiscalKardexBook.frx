      <TextObject Name="hdrCode" Left="395.0" Top="48" Width="30" Height="28" Border.Lines="All" Text="Cód. (*)" HorzAlign="Center" VertAlign="Center" WordWrap="true" Font="Arial, 7pt, style=Bold"/>
