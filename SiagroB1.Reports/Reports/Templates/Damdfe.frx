      <TextObject Name="Text8" Left="456" Top="80" Width="300" Height="30" Text="Consulta de autenticidade no portal nacional do MDF-e (https://dfe-portal.svrs.rs.gov.br/mdfe) ou pelo QR Code ao lado" Padding="2, 1, 2, 0" HorzAlign="Center" VertAlign="Top" WordWrap="true" Font="Arial, 6pt"/>
