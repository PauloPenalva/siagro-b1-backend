<?xml version="1.0" encoding="utf-8"?>
<!-- DAMDFE retrato (MDF-e 3.00, modal rodoviário), leiaute próprio inspirado no Manual de Orientação do Contribuinte do DAMDFE. Dados vêm de DamdfeReportService (mdfeProc autorizado). Cabeçalho repete em toda folha (FL n/N, passagem dupla); a lista de documentos é DataBand e quebra página; quadros de várias linhas crescem. Gerado por script: mantenha os nomes txt*. -->
<Report ScriptLanguage="CSharp" DoublePass="true" TextQuality="Regular" ReportInfo.Name="DAMDFE" ReportInfo.CreatorVersion="2026.1.0.0">
  <Dictionary>
    <BusinessObjectDataSource Name="DocumentLines" ReferenceName="DocumentLines" DataType="System.Int32" Enabled="true">
      <Column Name="Text" DataType="System.String"/>
      <Column Name="IsCity" DataType="System.Boolean" BindableControl="CheckBox"/>
    </BusinessObjectDataSource>
    <Parameter Name="pCompanyName" DataType="System.String" AsString=""/>
    <Parameter Name="pAccessKey" DataType="System.String" AsString=""/>
    <Parameter Name="pFormattedAccessKey" DataType="System.String" AsString=""/>
    <Parameter Name="pProtocol" DataType="System.String" AsString=""/>
    <Parameter Name="pQrCode" DataType="System.String" AsString=""/>
    <Parameter Name="pIssuerName" DataType="System.String" AsString=""/>
    <Parameter Name="pIssuerDetails" DataType="System.String" AsString=""/>
    <Parameter Name="pModal" DataType="System.String" AsString=""/>
    <Parameter Name="pModel" DataType="System.String" AsString=""/>
    <Parameter Name="pSeries" DataType="System.String" AsString=""/>
    <Parameter Name="pNumber" DataType="System.String" AsString=""/>
    <Parameter Name="pIssuedAt" DataType="System.String" AsString=""/>
    <Parameter Name="pUfStart" DataType="System.String" AsString=""/>
    <Parameter Name="pUfEnd" DataType="System.String" AsString=""/>
    <Parameter Name="pRoute" DataType="System.String" AsString=""/>
    <Parameter Name="pLoadingCities" DataType="System.String" AsString=""/>
    <Parameter Name="pCteCount" DataType="System.String" AsString=""/>
    <Parameter Name="pNfeCount" DataType="System.String" AsString=""/>
    <Parameter Name="pCargoValue" DataType="System.String" AsString=""/>
    <Parameter Name="pWeightUnit" DataType="System.String" AsString=""/>
    <Parameter Name="pGrossWeight" DataType="System.String" AsString=""/>
    <Parameter Name="pProduct" DataType="System.String" AsString=""/>
    <Parameter Name="pRntrc" DataType="System.String" AsString=""/>
    <Parameter Name="pVehicles" DataType="System.String" AsString=""/>
    <Parameter Name="pDrivers" DataType="System.String" AsString=""/>
    <Parameter Name="pCiot" DataType="System.String" AsString=""/>
    <Parameter Name="pTollVouchers" DataType="System.String" AsString=""/>
    <Parameter Name="pRemarks" DataType="System.String" AsString=""/>
  </Dictionary>
  <ReportPage Name="Page1" PaperWidth="210" PaperHeight="297" LeftMargin="5" RightMargin="5" TopMargin="5" BottomMargin="5" TitleBeforeHeader="false" Watermark.Font="Arial, 60pt">
    <PageHeaderBand Name="PageHeader1" Width="756" Height="192">
      <TextObject Name="Text1" Left="0" Top="0" Width="300" Height="160" Border.Lines="All" Border.Width="0.5" Text="" Padding="2, 1, 2, 0" HorzAlign="Left" VertAlign="Top" WordWrap="true" Font="Arial, 7pt"/>
      <PictureObject Name="picLogo" Left="4" Top="4" Width="90" Height="64" SizeMode="Zoom"/>
      <TextObject Name="txtIssuerName" Left="98" Top="4" Width="198" Height="64" Text="[pIssuerName]" Padding="2, 1, 2, 0" HorzAlign="Left" VertAlign="Center" WordWrap="true" Font="Arial, 9pt, style=Bold"/>
      <TextObject Name="txtIssuerDetails" Left="4" Top="72" Width="292" Height="86" Text="[pIssuerDetails]" Padding="2, 1, 2, 0" HorzAlign="Left" VertAlign="Top" WordWrap="true" Font="Arial, 7pt"/>
      <TextObject Name="Text2" Left="300" Top="0" Width="156" Height="160" Border.Lines="All" Border.Width="0.5" Text="" Padding="2, 1, 2, 0" HorzAlign="Left" VertAlign="Top" WordWrap="true" Font="Arial, 7pt"/>
      <TextObject Name="Text3" Left="300" Top="2" Width="156" Height="16" Text="DAMDFE" Padding="2, 1, 2, 0" HorzAlign="Center" VertAlign="Top" WordWrap="true" Font="Arial, 12pt, style=Bold"/>
      <TextObject Name="Text4" Left="300" Top="18" Width="156" Height="24" Text="Documento Auxiliar de Manifesto Eletrônico de Documentos Fiscais" Padding="2, 1, 2, 0" HorzAlign="Center" VertAlign="Top" WordWrap="true" Font="Arial, 6pt"/>
      <TextObject Name="Text5" Left="300" Top="44" Width="156" Height="9" Text="MODAL" Padding="2, 1, 2, 0" HorzAlign="Center" VertAlign="Top" WordWrap="true" Font="Arial, 5.5pt, style=Bold"/>
      <TextObject Name="txtModal" Left="300" Top="52" Width="156" Height="14" Text="[pModal]" Padding="2, 1, 2, 0" HorzAlign="Center" VertAlign="Top" WordWrap="true" Font="Arial, 8pt, style=Bold"/>
      <BarcodeObject Name="bcQrCode" Left="335" Top="70" Width="86" Height="86" AutoSize="false" Text="[[pQrCode] ?? &quot;&quot;]" ShowText="false" AllowExpressions="true" Barcode="QR Code" Barcode.ErrorCorrection="M" Barcode.Encoding="UTF8" Barcode.QuietZone="false"/>
      <TextObject Name="Text6" Left="456" Top="0" Width="300" Height="160" Border.Lines="All" Border.Width="0.5" Text="" Padding="2, 1, 2, 0" HorzAlign="Left" VertAlign="Top" WordWrap="true" Font="Arial, 7pt"/>
