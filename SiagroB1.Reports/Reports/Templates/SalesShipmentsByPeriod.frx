        <TextObject Name="txtDiscountWeight" Left="776" Width="82" Height="17" Text="[SalesShipments.DiscountWeight]" Format="Number" Format.UseLocale="true" Format.DecimalDigits="3" HorzAlign="Right" Trimming="EllipsisCharacter" VertAlign="Center" WordWrap="false" Font="Consolas, 7pt"/>
        <TextObject Name="txtNetWeight" Left="858" Width="82" Height="17" Text="[SalesShipments.NetWeight]" Format="Number" Format.UseLocale="true" Format.DecimalDigits="3" HorzAlign="Right" Trimming="EllipsisCharacter" VertAlign="Center" WordWrap="false" Font="Consolas, 7pt"/>
